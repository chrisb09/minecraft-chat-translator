# =====================================================================
# API Keys Configuration
# =====================================================================

# Google AI Studio API Keys (Comma-separated for multi-account rotation)
GEMINI_API_KEYS=

# OpenRouter API Keys (Comma-separated for multi-account rotation)
OPENROUTER_API_KEYS=

# =====================================================================
# Google AI Studio Models, Limits & Capabilities (Parallel Lists)
# Capabilities: 1-10 integer score (higher = more capable / intelligent)
# =====================================================================
GEMINI_MODEL_IDS=gemma-4-26b-a4b-it, gemma-4-31b-it, gemini-3.5-flash-lite, gemini-3.1-flash-lite
GEMINI_RPMS=30, 30, 15, 15
GEMINI_TPMS=16K, 16K, 250K, 250K
GEMINI_RPDS=14.4K, 14.4K, 500, 500
GEMINI_CAPABILITIES=4, 4, 6, 5

# =====================================================================
# OpenRouter Models, Limits & Capabilities (Parallel Lists)
# =====================================================================
OPENROUTER_MODEL_IDS=stealth/ox-alpha
OPENROUTER_RPMS=20
OPENROUTER_TPMS=100K
OPENROUTER_RPDS=2000
OPENROUTER_CAPABILITIES=9
